PORT=4000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:8081,http://localhost:8082,http://127.0.0.1:8081,http://127.0.0.1:8082

# 관리자 웹: 서버에서만 설정합니다. ADMIN_PASSWORD_HASH는 bcrypt 해시입니다.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_NAME=관리자

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=signjang_app
DB_PASSWORD=replace_me
DB_NAME=signjang
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT_MS=10000

JWT_SECRET=replace_with_at_least_32_random_characters
SMS_CODE_PEPPER=replace_with_another_random_secret
SMS_CODE_TTL_SECONDS=180
# Explicitly approved phones only: update an existing active account after real SMS verification.
SIGNUP_ACCOUNT_UPDATE_PHONE_ALLOWLIST=
# 인증문자와 계약서 MMS는 알리고로 실제 발송합니다.
# 자동 테스트에서만 SMS_DEV_MODE=true를 명시하세요.
SMS_DEV_MODE=false
# 지정된 번호만 인증문자 요청·확인 및 사업 정보 단계의 전화번호 중복 검사를 생략합니다(쉼표 구분).
# 인증번호 검증·발송 제한·최종 회원가입의 중복 검사는 유지됩니다.
SMS_SIGNUP_DUPLICATE_PHONE_ALLOWLIST=

SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=

# 인증문자(SMS)와 계약서 이미지(MMS) 발송용 계정. 발신번호는 사전 등록되어야 합니다.
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_SENDER=

# 기상청 API Hub 동네예보 인증키. 모바일 앱에 넣지 말고 서버의 .env.local에만 설정하세요.
# https://apihub.kma.go.kr/apiList.do?seqApi=10
KMA_API_KEY=
KMA_API_BASE_URL=https://apihub.kma.go.kr/api/typ02/openApi/VilageFcstInfoService_2.0/
WEATHER_CACHE_TTL_SECONDS=300
WEATHER_STALE_TTL_SECONDS=1800
WEATHER_REQUEST_TIMEOUT_MS=8000

# 현장 주소를 위도·경도로 바꾸는 Kakao Local REST API 키입니다. APK에 넣지 말고
# 운영 서버의 .env에만 설정하세요. 미설정 시 기존 저장 좌표는 사용할 수 있지만
# 새 주소의 서버측 위치 보정과 기존 계약서 일괄 보정은 503으로 안내됩니다.
# https://developers.kakao.com/docs/ko/local/dev-guide
KAKAO_REST_API_KEY=
KAKAO_LOCAL_API_BASE_URL=https://dapi.kakao.com/v2/local/search/address.json
KAKAO_LOCAL_API_TIMEOUT_MS=8000
